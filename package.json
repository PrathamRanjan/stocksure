{
  "name": "stocksure",
  "version": "0.1.0",
  "private": true,
  "description": "StockSure: receive it, resolve it, pay correctly, keep trading.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "worker": "node --env-file-if-exists=.env dist/worker-main.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs && npm run build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix web run typecheck",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "sandbox:check": "tsx --env-file-if-exists=.env scripts/sandbox-check.ts",
    "eval:three-arm": "tsx --env-file-if-exists=.env scripts/eval-three-arm.ts",
    "eval:arena": "tsx --env-file-if-exists=.env scripts/eval-arena.ts",
    "eval:proof": "tsx --env-file-if-exists=.env scripts/proof.ts",
    "agent:demo": "tsx --env-file-if-exists=.env scripts/agent-demo.ts",
    "build:web": "npm --prefix web ci --include=dev --no-audit --no-fund && npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "e2e": "npm --prefix web run e2e"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/busboy": "^1.5.5",
    "@types/compression": "^1.8.1",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "ws": "^8.22.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
