PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# After registering ${APP_URL}/webhooks/paypal on the PayPal app (optional: settlement reads PayPal back itself)
PAYPAL_WEBHOOK_ID=
APP_URL=http://localhost:3300
PORT=3300
# Unset = PGlite (Postgres in WebAssembly) in ./data
DATABASE_URL=
SESSION_SECRET=
SS_CURRENCY=USD
# Delivery note / invoice / photo reading. Unset = deterministic text parser; images stored as evidence only.
ANTHROPIC_API_KEY=
SS_MODEL=claude-haiku-5-5
# Demo: persona sign-in, sample documents, PayPal fault injection
SS_DEMO_MODE=true
SS_INLINE_WORKER=true
SS_MAX_UPLOAD_BYTES=5242880

# --- Integrations (all optional; unset = simulated, visible on /ops/channels) ---
# Brain: openai | anthropic | unset = deterministic rules
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Telegram bot: register ${APP_URL}/webhooks/telegram with secret_token = TELEGRAM_WEBHOOK_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API: register ${APP_URL}/webhooks/whatsapp with WHATSAPP_VERIFY_TOKEN
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# AG Grid Enterprise / AG Studio licence (unset = community grid)
AG_STUDIO_LICENSE=
SS_COUNTERSIGN_ABOVE_CENTS=50000
